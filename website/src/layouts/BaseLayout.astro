---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'Robo Buddy — The Desktop Pet, Reimagined for the Modern Era',
  description = 'A lightweight desktop companion for Windows that dances to your music, climbs your windows, and talks back. 3D & 2D custom characters, webcam motion capture, and local AI.',
  currentPath = '/'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤖</text></svg>" />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Robo Buddy" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <!-- Fonts: Inter-like system font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-buddy-bg text-buddy-text min-h-screen flex flex-col relative antialiased selection:bg-buddy-cyan selection:text-black">
    <!-- Ambient ambient glow backgrounds -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-buddy-cyan/15 rounded-full blur-3xl"></div>
      <div class="absolute top-1/4 -right-40 w-[30rem] h-[30rem] bg-buddy-purple/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/3 left-1/3 w-80 h-80 bg-buddy-cyan/10 rounded-full blur-3xl"></div>
      <div class="absolute inset-0 retro-grid opacity-60"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <Navbar currentPath={currentPath} />
      <main class="flex-grow">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
