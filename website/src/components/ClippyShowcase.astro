---
---

<section id="clippy" class="py-24 border-t border-buddy-border bg-buddy-bg/60 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Copy & Details -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-500/30 bg-cyan-500/10 text-cyan-400 text-xs font-semibold uppercase tracking-wider">
          <span>Brand New Feature</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
          Clippy Got an Upgrade. <br />
          <span class="text-gradient-cyan">Meet Context Awareness.</span>
        </h2>
        <p class="text-sm sm:text-base text-buddy-muted leading-relaxed">
          Remember when desktop pets gave unsolicited advice? Robo Buddy turns that nostalgia into a genuinely useful desktop partner. He detects what app you are currently working in and chimes in with tips, coding jokes, focus reminders, and interactive action chips.
        </p>

        <div class="space-y-4 pt-2">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-sm flex-none mt-0.5">
              💡
            </div>
            <div>
              <h4 class="text-sm font-semibold text-white">Interactive Action Chips</h4>
              <p class="text-xs text-buddy-muted mt-0.5 leading-relaxed">
                Clickable chips in his speech bubble launch pre-filled AI chats, trigger focus timers, or pull up cheat-sheets without breaking your flow.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-sm flex-none mt-0.5">
              🔒
            </div>
            <div>
              <h4 class="text-sm font-semibold text-white">Zero Telemetry & Automatic Blacklists</h4>
              <p class="text-xs text-buddy-muted mt-0.5 leading-relaxed">
                Process names and window titles are processed 100% locally. Password managers (1Password, Bitwarden, KeePass) and private/incognito windows are automatically filtered out.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 text-sm flex-none mt-0.5">
              🧘
            </div>
            <div>
              <h4 class="text-sm font-semibold text-white">Anti-Annoyance Dwell Filtering</h4>
              <p class="text-xs text-buddy-muted mt-0.5 leading-relaxed">
                Buddy requires at least 18 seconds of continuous focus in an app before saying anything. Rapid Alt-Tabbing never causes spam, and reactions pause completely while you are AFK.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Simulated Desktop Window -->
      <div class="lg:col-span-6">
        <div class="relative rounded-2xl border border-buddy-border bg-buddy-card/90 shadow-2xl overflow-hidden p-1 backdrop-blur-xl">
          <!-- Window Titlebar -->
          <div class="h-10 bg-buddy-bg/90 border-b border-buddy-border flex items-center justify-between px-4 rounded-t-xl">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
              <span class="ml-2 text-xs font-mono text-buddy-muted">main.rs — Visual Studio Code</span>
            </div>
            <div class="text-[11px] font-mono text-cyan-400 bg-cyan-500/10 px-2 py-0.5 rounded border border-cyan-500/30">
              Active Focus
            </div>
          </div>

          <!-- Code Mockup Editor -->
          <div class="p-6 bg-[#0a0f1d] font-mono text-xs text-buddy-muted space-y-2 relative min-h-[300px]">
            <div class="text-buddy-darkMuted">// Writing rust backend in VS Code...</div>
            <div><span class="text-purple-400">pub fn</span> <span class="text-cyan-400">handle_companion_context</span>(app: &amp;AppHandle) &rarr; <span class="text-emerald-400">Result</span>&lt;(), <span class="text-pink-400">String</span>&gt; &#123;</div>
            <div class="pl-4 text-buddy-text">let win = app.get_webview_window(<span class="text-yellow-300">"buddy"</span>);</div>
            <div class="pl-4 text-buddy-text">win.evaluate_rules(&amp;local_rules)?;</div>
            <div>&#125;</div>

            <!-- Simulated Floating Buddy on Window Title Bar with Speech Bubble -->
            <div class="absolute right-6 bottom-8 max-w-xs animate-float">
              <!-- Speech Bubble -->
              <div class="bg-buddy-bg/95 border border-cyan-500/40 rounded-2xl p-4 shadow-xl shadow-cyan-500/10 relative backdrop-blur-md mb-3">
                <div class="flex items-center gap-2 mb-1.5">
                  <img src="/images/logo-icon.png" alt="Robo Buddy" class="w-4 h-4 object-contain rounded-full" />
                  <span class="text-[11px] font-bold text-white">Robo Buddy</span>
                  <span class="text-[9px] font-mono text-cyan-400 px-1 rounded bg-cyan-500/10">Coding Mode</span>
                </div>
                <p class="text-xs text-buddy-text leading-relaxed">
                  "Writing poetry in Rust? Don't forget to run <code>cargo check</code> before committing!"
                </p>
                <!-- Clickable Action Chips -->
                <div class="mt-3 flex flex-wrap gap-1.5 pt-2 border-t border-white/10">
                  <button type="button" class="px-2 py-1 rounded-md bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/40 text-[10px] text-cyan-300 font-medium transition-colors">
                    Regex Cheat-sheet
                  </button>
                  <button type="button" class="px-2 py-1 rounded-md bg-purple-500/20 hover:bg-purple-500/30 border border-purple-500/40 text-[10px] text-purple-300 font-medium transition-colors">
                    Explain Error
                  </button>
                  <button type="button" class="px-2 py-1 rounded-md bg-white/5 hover:bg-white/10 border border-white/10 text-[10px] text-buddy-darkMuted transition-colors">
                    Mute App
                  </button>
                </div>
                <!-- Little triangle arrow pointing down -->
                <div class="absolute -bottom-2 right-12 w-4 h-4 bg-buddy-bg border-r border-b border-cyan-500/40 transform rotate-45"></div>
              </div>

              <!-- Mini Buddy Avatar -->
              <div class="flex justify-end pr-10">
                <div class="w-14 h-14 rounded-full bg-gradient-to-br from-buddy-cyan to-buddy-purple p-0.5 shadow-lg">
                  <div class="w-full h-full bg-buddy-bg rounded-full flex items-center justify-center p-1.5 overflow-hidden">
                    <img src="/images/logo-icon.png" alt="Robo Buddy" class="w-full h-full object-contain" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
