---
const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-buddy-bg/80 border-b border-buddy-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <img
        src="/images/logo.png"
        alt="Robo Buddy"
        class="h-9 sm:h-10 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
      />
      <span class="hidden sm:inline-block text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-buddy-cyan/10 border border-buddy-cyan/30 text-buddy-cyan font-semibold">
        v0.6.0
      </span>
    </a>

    <!-- Nav links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      <a href="/#features" class="text-buddy-muted hover:text-white transition-colors">Features</a>
      <a href="/#demos" class="text-buddy-muted hover:text-white transition-colors">Demos</a>
      <a href="/#clippy" class="text-buddy-muted hover:text-white transition-colors flex items-center gap-1.5">
        <span>Clippy Mode</span>
        <span class="w-1.5 h-1.5 rounded-full bg-buddy-cyan animate-pulse"></span>
      </a>
      <a href="/guide" class={`transition-colors ${currentPath.startsWith('/guide') ? 'text-buddy-cyan font-semibold' : 'text-buddy-muted hover:text-white'}`}>
        Docs & Guide
      </a>
      <a href="https://github.com/MrSco/robo-buddy-releases" target="_blank" rel="noopener noreferrer" class="text-buddy-muted hover:text-white transition-colors flex items-center gap-1">
        <span>Releases</span>
        <svg class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </nav>

    <!-- CTAs -->
    <div class="flex items-center gap-3">
      <a 
        href="https://github.com/MrSco/robo-buddy-releases" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-buddy-border text-xs text-buddy-text hover:bg-buddy-card transition-colors"
        title="View source and releases on GitHub"
      >
        <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
        <span>GitHub</span>
      </a>
      
      <a 
        href="/#download"
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-lg bg-gradient-to-r from-buddy-cyan to-buddy-purple hover:brightness-110 text-white text-xs font-semibold shadow-lg shadow-buddy-cyan/20 transition-all hover:scale-[1.02]"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        <span>Download Free</span>
      </a>
    </div>
  </div>
</header>
