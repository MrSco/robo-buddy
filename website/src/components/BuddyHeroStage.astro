    document.getElementById('btn-action-throw')?.addEventListener('click', () => {
      isHeld = false;
      isFalling = true;
      isDancing = false;
      isWalking = false;
      isAttacking = false;
      currentLedge = null;

      const maxPosY = CEILING_Y - footOffset - currentTargetHeight;
      const headroom = Math.max(0.15, maxPosY - posY);
      const maxWall = getVisibleHeroWall();
      velX = (Math.random() - 0.5) * Math.min(3.5, maxWall * 2.2);
      velY = Math.min(4.5, Math.sqrt(2 * GRAVITY * headroom * 0.85));
      tumbleVel = (Math.random() - 0.5) * 3.0;

      playClip('jump', { loop: false, fade: 0.1 });
      const quote = activeDef.thrownQuotes[Math.floor(Math.random() * activeDef.thrownQuotes.length)];
