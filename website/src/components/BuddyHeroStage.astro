    function handleTalkPrompt(prompt: string) {
      const p = prompt.toLowerCase();
      talkBox?.classList.add('hidden');

      if (p.includes('dance')) {
        isDancing = true;
        playClip('dance', { loop: true, fade: 0.25 });
        showBubble('Affirmative. Executing robot hip-hop routine.', 4000);
        setManualActionTimeout(3800);
      } else if (p.includes('terminate') || p.includes('kill')) {
        pokeBuddy();
        showBubble('Target acquired. Hasta la vista, baby.', 4000);
        setManualActionTimeout(2000);
      } else if (p.includes('kick') || p.includes('punch') || p.includes('attack')) {
        const target = document.getElementById('mock-window-widget') || document.getElementById('mock-window-term');
        triggerAttack(target, p.includes('punch') ? 'punch' : 'kick');
        setManualActionTimeout(3500);
      } else if (p.includes('jump') || p.includes('climb')) {
        climbOntoPlatform();
        setManualActionTimeout(3800);
      } else if (p.includes('joke')) {
        if (activeDef.id === 't-800') {
          showBubble('A terminator walks into a bar. There were no survivors.', 5000);
        } else {
          showBubble('Why did the desktop pet cross the road? To climb the other window!', 5000);
        }
      } else if (p.includes('who are you') || p.includes('what are you')) {
        if (activeDef.id === 't-800') {
          showBubble('Cyberdyne Systems Model 101. Living tissue over metal endoskeleton.', 5000);
        } else {
          showBubble(`I am ${activeDef.name}, your modern desktop buddy!`, 4500);
        }
      } else {
        const replies = activeDef.defaultQuotes;
        const reply = replies[Math.floor(Math.random() * replies.length)];
        showBubble(reply, 4500);
      }
    }

    // Resize Handler
    function handleResize() {
      if (!container || !canvas) return;
      width = container.clientWidth || window.innerWidth || 1200;
      height = container.clientHeight || 700;
      camera.aspect = width / height;
      if (width < 768) {
        camera.position.set(0, 0.65, 3.8);
      } else {
        camera.position.set(0, 0.75, 3.4);
      }
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
      applyResponsiveScale();
      updateFloorY();
      updateCeilingY();
      const maxWall = getVisibleHeroWall();
      posX = Math.max(-maxWall, Math.min(maxWall, posX));
      if (!isFalling && !currentLedge && !isHeld) {
        posY = FLOOR_Y;
      }
    }
    window.addEventListener('resize', handleResize);

    // Main Animation / Physics Loop
    const clock = new THREE.Clock();
    const GRAVITY = 9.8;

    function animate() {
      requestAnimationFrame(animate);
      const dt = Math.min(clock.getDelta(), 0.1);
      const maxPosY = CEILING_Y - footOffset - currentTargetHeight;

      // 1. UPDATE CHARACTER ANIMATIONS (Calls beginFrame(dt) to update mixer and bones!)
      if (activeCharacter) {
        activeCharacter.update(dt);
      }

      // Update hold and flip transition amounts for limb grabbing
      const isLimbGrab = currentGrabPart === 'leftLeg' || currentGrabPart === 'rightLeg';
      flipAmount += ((isHeld && isLimbGrab ? 1 : 0) - flipAmount) * Math.min(1, dt * 7);
      heldAmount += ((isHeld ? 1 : 0) - heldAmount) * Math.min(1, dt * 10);

      // Apply desktop-style limb grabbing procedural poses
      if (heldAmount > 0.001 && activeCharacter) {
        const elapsed = clock.getElapsedTime();
        if (currentGrabPart === 'leftArm' || currentGrabPart === 'rightArm') {
          applyHeldByArm(activeCharacter, currentGrabPart === 'leftArm' ? 'left' : 'right', elapsed, heldAmount);
        } else if (currentGrabPart === 'leftLeg' || currentGrabPart === 'rightLeg') {
          applyHeldByLeg(activeCharacter, currentGrabPart === 'leftLeg' ? 'left' : 'right', elapsed, heldAmount);
        } else {
          applyDangle(activeCharacter, elapsed, heldAmount);
        }
      }

      // Procedural attack progress (punch / kick)
      if (isAttacking && activeCharacter) {
        attackTime += dt;
        const progress = Math.min(1, attackTime / attackDuration);
        applyAttack(activeCharacter, attackKind, progress);
        if (progress >= 1) {
          isAttacking = false;
          if (!isFalling && !isHeld) {
            if (maxPosY - posY < 0.16) {
              isCrouching = true;
              playClip('crouch', { loop: true, fade: 0.2 });
            } else {
              isCrouching = false;
              playClip('idle', { loop: true, fade: 0.25 });
            }
          }
        }
      }

      // Hard clamp: Buddy NEVER penetrates the ceiling header!
      if (posY > maxPosY) {
        const excess = posY - maxPosY;
        if (currentLedge && excess > 0.22) {
          // Not enough clearance to stand or crouch on this ledge! Bonk and fall off!
          currentLedge = null;
          isFalling = true;
          velY = -1.8;
          velX = posX > 0 ? -1.2 : 1.2;
          tumbleVel = (Math.random() - 0.5) * 3.5;
          playClip('hit', { loop: false, fade: 0.1 });
          showBubble('*Bonk!* Clearance insufficient up here!', 2500);
        } else {
          posY = maxPosY;
        }
      }

      // Authored clip crouch / duck when approaching or under ceiling header
      if (!isFalling && !isHeld && activeCharacter) {
        const headroom = maxPosY - posY;
        if (headroom < 0.16) {
          if (!isCrouching && !isWalking && !isDancing && !isAttacking) {
            isCrouching = true;
            playClip('crouch', { loop: true, fade: 0.2 });
          }
        } else if (isCrouching) {
          isCrouching = false;
          if (!isWalking && !isDancing && !isAttacking) {
            playClip('idle', { loop: true, fade: 0.25 });
          }
        }
      }

      // 2. AUTONOMOUS DESKTOP-LIKE ROAMING SHOWCASE
      if (!isHeld && !isFalling && !isDancing && !isPoked && !isAttacking) {
        nextAutoAction -= dt;
        if (nextAutoAction <= 0) {
          nextAutoAction = 4.0 + Math.random() * 3.5;
          const choice = Math.random();

          if (currentLedge) {
            // If on a window or button ledge:
            // 50% hop down to taskbar
            // 25% balance dance
            // 25% deliver kick/punch attack to current window
            if (choice < 0.50) {
              currentLedge = null;
              isFalling = true;
              velX = posX > 0 ? -(Math.random() * 1.2 + 0.4) : (Math.random() * 1.2 + 0.4);
              velY = 1.4;
              playClip('jump', { loop: false, fade: 0.1 });
              showBubble('Hopping down to the taskbar.', 2200);
            } else if (choice < 0.75) {
              isDancing = true;
              playClip('dance', { loop: true, fade: 0.3 });
              showBubble('Balancing on the ledge!', 3500);
              window.setTimeout(() => {
                if (isDancing) {
                  isDancing = false;
                  playClip('idle', { loop: true, fade: 0.3 });
                }
              }, 3500);
            } else {
              const ledgeEl = currentLedge.id ? document.getElementById(currentLedge.id) : null;
              triggerAttack(ledgeEl, Math.random() < 0.5 ? 'kick' : 'punch');
            }
          } else {
            // On taskbar floor:
            // 30% climb onto a varied window/button platform
            // 35% walk across taskbar
            // 15% dance routine
            // 12% kick / punch test a desktop window
            // 8% idle fidget
            if (choice < 0.30) {
              climbOntoPlatform();
            } else if (choice < 0.65) {
              isWalking = true;
              const maxWall = getVisibleHeroWall();
              autoTargetX = (Math.random() - 0.5) * 2 * (maxWall * 0.85);
              targetRotY = autoTargetX > posX ? Math.PI / 2 : -Math.PI / 2;
              playClip('walk', { loop: true, fade: 0.25 });
            } else if (choice < 0.80) {
              isDancing = true;
              playClip('dance', { loop: true, fade: 0.3 });
              const quote = activeDef.danceQuotes[Math.floor(Math.random() * activeDef.danceQuotes.length)];
              showBubble(quote, 4000);
              window.setTimeout(() => {
                if (isDancing) {
                  isDancing = false;
                  playClip('idle', { loop: true, fade: 0.3 });
                }
              }, 3800);
            } else if (choice < 0.92) {
              const widgetEl = document.getElementById('mock-window-widget') || document.getElementById('mock-window-term');
              triggerAttack(widgetEl, Math.random() < 0.5 ? 'kick' : 'punch');
            } else {
              isWalking = false;
              playClip('idle', { loop: true, fade: 0.3 });
            }
          }
        }

        // Handle walking towards target
        if (isWalking) {
          const walkSpeed = 1.2;
          const dist = autoTargetX - posX;
          if (Math.abs(dist) > 0.1) {
            const dir = Math.sign(dist);
            posX += dir * walkSpeed * dt;
            targetRotY = dir > 0 ? Math.PI / 2 : -Math.PI / 2;
          } else {
            isWalking = false;
            targetRotY = 0;
            if (maxPosY - posY < 0.16) {
              isCrouching = true;
              playClip('crouch', { loop: true, fade: 0.25 });
            } else {
              isCrouching = false;
              playClip('idle', { loop: true, fade: 0.3 });
            }
          }
        }
      }

      // Smooth rotation towards target facing
      if (!isHeld && !isFalling) {
        rotY += (targetRotY - rotY) * 0.1;
      }

      // 3. PHYSICS SIMULATION
      const platforms = getHeroPlatforms();
      const HERO_WALL = getVisibleHeroWall();

      if (isFalling) {
        velY -= GRAVITY * dt;
        posX += velX * dt;
        posY += velY * dt;
        tumbleAngle += tumbleVel * dt;

        // Ceiling collision & head bonk (Header navbar is the ceiling!)
        if (posY >= maxPosY) {
          posY = maxPosY;
          if (velY > 0) {
            velY = -Math.abs(velY) * 0.55;
            tumbleVel = (Math.random() - 0.5) * 4.0;
            playClip('hit', { loop: false, fade: 0.1 });
            const bonkQuotes = [
              '*Bonk!* Ouch, hit the ceiling!',
              'Clearance insufficient! Head collision detected.',
              'Watch the ceiling! Negative clearance.',
              '*Clang!* Cybernetic chassis impact!'
            ];
            showBubble(bonkQuotes[Math.floor(Math.random() * bonkQuotes.length)], 2200);
          }
        }

        // Wall collisions
        if (posX > HERO_WALL) {
          posX = HERO_WALL;
          velX = -velX * 0.45;
          tumbleVel = -tumbleVel * 0.5;
        } else if (posX < -HERO_WALL) {
          posX = -HERO_WALL;
          velX = -velX * 0.45;
          tumbleVel = -tumbleVel * 0.5;
        }

        // Platform / Furniture landing check
        for (const plat of platforms) {
          if (
            posX >= plat.xMin &&
            posX <= plat.xMax &&
            posY <= plat.yTop &&
            posY >= plat.yTop - 0.45 &&
            velY <= 0
          ) {
            posY = plat.yTop;
            isFalling = false;
            velX = 0;
            velY = 0;
            currentLedge = plat;

            playClip('land', { loop: false, fade: 0.1 });
            showBubble(plat.speech, 4500);

            window.setTimeout(() => {
              if (!isFalling && !isHeld && activeCharacter) {
                if (getMaxPosY() - posY < 0.16) {
                  isCrouching = true;
                  playClip('crouch', { loop: true, fade: 0.25 });
                } else {
                  isCrouching = false;
                  playClip('idle', { loop: true, fade: 0.25 });
                }
              }
            }, 700);
            break;
          }
        }

        // Floor collision
        if (isFalling && posY <= FLOOR_Y) {
          posY = FLOOR_Y;
          currentLedge = null;
          if (Math.abs(velY) > 1.8) {
            velY = -velY * 0.35;
            velX *= 0.6;
          } else {
            isFalling = false;
            velX = 0;
            velY = 0;

            playClip('land', { loop: false, fade: 0.1 });
            window.setTimeout(() => {
              if (!isFalling && !isHeld && !isDancing && activeCharacter) {
                if (getMaxPosY() - posY < 0.16) {
                  isCrouching = true;
                  playClip('crouch', { loop: true, fade: 0.25 });
                } else {
                  isCrouching = false;
                  playClip('idle', { loop: true, fade: 0.25 });
                }
              }
            }, 750);
          }
        }
      }

      // Upright spring recovery (smoothly pull Buddy upright whenever not tumbling in free fall)
      if (!isFalling && !isHeld && (Math.abs(tumbleAngle) > 0.001 || Math.abs(tumbleVel) > 0.001)) {
        tumbleVel += (-35 * tumbleAngle - 8 * tumbleVel) * dt;
        tumbleAngle += tumbleVel * dt;
        if (Math.abs(tumbleAngle) < 0.005 && Math.abs(tumbleVel) < 0.01) {
          tumbleAngle = 0;
          tumbleVel = 0;
        }
      }

      // 4. SMOOTH LOOK-AT TRACKING (World-space distributed across chest, neck, head - no cocked neck!)
      if (!isFalling && !isHeld && activeCharacter && canvas) {
        let targetYaw = 0;
        let targetPitch = 0;
        if (cursorValid) {
          const cRect = canvas.getBoundingClientRect();
          const headPos = new THREE.Vector3();
          const hBone = activeCharacter.bone('head');
          if (hBone) {
            hBone.getWorldPosition(headPos);
          } else {
            headPos.set(posX, posY + 0.85, posZ);
          }
          headPos.project(camera);
          const screenHeadX = ((headPos.x + 1) / 2) * cRect.width + cRect.left;
          const screenHeadY = ((-headPos.y + 1) / 2) * cRect.height + cRect.top;
          const dx = cursorScreenX - screenHeadX;
          const dy = cursorScreenY - screenHeadY;
          targetYaw = THREE.MathUtils.clamp(dx / (cRect.width * 0.35), -1, 1) * 0.75;
          targetPitch = THREE.MathUtils.clamp(-dy / (cRect.height * 0.35), -1, 1) * 0.45;
        }

        const k = 1 - Math.exp(-dt * 9);
        currentYaw += (targetYaw - currentYaw) * k;
        currentPitch += (targetPitch - currentPitch) * k;

        // Dampen head look-at when character is walking or turned sideways
        const lookScale = 1 - Math.min(1, Math.abs(rotY) / 1.2);
        applyLookAt(activeCharacter, currentYaw * lookScale, currentPitch * lookScale, 0);
      }

      // 4b. DESKTOP-STYLE RAGDOLL LIMB SPRINGS & SECONDARY MOTION
      if (isFalling) {
        accelX = THREE.MathUtils.clamp(velX * 0.45, -2.5, 2.5);
        accelY = THREE.MathUtils.clamp(-velY * 0.35, -2.5, 2.5);
      } else if (!isHeld) {
        accelX += (0 - accelX) * Math.min(1, dt * 8);
        accelY += (0 - accelY) * Math.min(1, dt * 8);
      }

      const wantSprings = isHeld || isFalling;
      springAmount += ((wantSprings ? 1 : 0) - springAmount) * Math.min(1, dt * (wantSprings ? 9 : 3));
      const rigid = isHeld && currentGrabPart !== 'torso' ? currentGrabPart : null;

      if (activeCharacter) {
        if (isFalling && Math.hypot(velX, velY) > 2.0) {
          applyFlail(activeCharacter, clock.getElapsedTime());
        }
        springs.update(activeCharacter, dt, clock.getElapsedTime(), accelX, accelY, springAmount, rigid);
      }

      // 5. UPDATE CHARACTER TRANSFORMS IN SCENE
      if (activeCharacter) {
        // Leg hold: whole body flips upside down about the grab side
        const flip = flipAmount * Math.PI * (currentGrabPart === 'leftLeg' ? -1 : 1);

        // Pivot about hips/center of mass during tumble so rotation doesn't swing in a massive circle around feet
        const half = currentTargetHeight * 0.5;
        const totalZRot = tumbleAngle + flip;
        const offsetX = Math.abs(totalZRot) > 0.001 ? half * Math.sin(totalZRot) : 0;
        const offsetY = Math.abs(totalZRot) > 0.001 ? half * (1 - Math.cos(totalZRot)) : 0;
        const flipLift = flipAmount * currentTargetHeight;

        activeCharacter.root.position.set(posX + offsetX, posY + footOffset + offsetY + flipLift, posZ);
        activeCharacter.root.rotation.set(0, rotY, totalZRot);

        // Shadow follows on floor or platform (fades when upside down or airborne)
        shadowMesh.position.x = posX;
        shadowMesh.position.z = posZ;
        shadowMesh.position.y = (currentLedge ? currentLedge.yTop : FLOOR_Y) + 0.01;
        const distFromGround = posY - (currentLedge ? currentLedge.yTop : FLOOR_Y);
        const shadowScale = Math.max(0.15, (1.0 - distFromGround * 0.3) * (1 - flipAmount * 0.5));
        shadowMesh.scale.set(shadowScale, shadowScale, shadowScale);
      }

      // 6. UPDATE SPEECH BUBBLE POSITION OVER HEAD
      updateSpeechBubblePos();

      // 7. RENDER THREE.JS SCENE
      renderer.render(scene, camera);
    }

    // Start loading T-800 default!
    switchCharacter(CHARACTERS[0]);
    animate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroStage);
  } else {
    initHeroStage();
  }
</script>
