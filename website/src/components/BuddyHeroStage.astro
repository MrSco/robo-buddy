---
import { CHARACTERS } from '../lib/character-loader';
---

<div id="buddy-stage-container" class="absolute inset-0 w-full h-full select-none pointer-events-none z-20 overflow-hidden">
  <!-- Unified Floating Command Center & Character Selector (Top Right on desktop, top full-width strip on mobile) -->
  <div class="absolute top-2 left-2 right-2 sm:left-auto sm:right-6 sm:top-4 z-30 flex items-center justify-between sm:justify-start gap-1 sm:gap-1.5 p-1 sm:p-1.5 rounded-2xl bg-black/85 border border-white/15 shadow-2xl backdrop-blur-xl pointer-events-auto overflow-x-auto no-scrollbar max-w-[calc(100vw-16px)] sm:max-w-none">
    <!-- Action Command Buttons -->
    <div class="flex items-center gap-0.5 sm:gap-1 shrink-0">
      <button id="btn-action-talk" type="button" class="px-2 py-1 sm:px-2.5 sm:py-1 rounded-xl bg-white/5 hover:bg-white/15 text-xs text-white font-medium transition-all hover:scale-105 active:scale-95 flex items-center gap-1" title="Talk with Buddy">
        <span>💬</span>
        <span class="hidden md:inline">Talk</span>
      </button>
      <button id="btn-action-dance" type="button" class="px-2 py-1 sm:px-2.5 sm:py-1 rounded-xl bg-buddy-cyan/20 hover:bg-buddy-cyan/30 text-buddy-cyanLight text-xs font-semibold border border-buddy-cyan/30 transition-all hover:scale-105 active:scale-95 flex items-center gap-1" title="Dance Routine">
        <span>🕺</span>
        <span class="hidden md:inline">Dance</span>
      </button>
      <button id="btn-action-run" type="button" class="px-2 py-1 sm:px-2.5 sm:py-1 rounded-xl bg-buddy-purple/20 hover:bg-buddy-purple/30 text-buddy-purpleLight text-xs font-semibold border border-buddy-purple/30 transition-all hover:scale-105 active:scale-95 flex items-center gap-1" title="Roam Taskbar Floor">
        <span>🏃</span>
        <span class="hidden md:inline">Roam</span>
      </button>
      <button id="btn-action-climb" type="button" class="px-2 py-1 sm:px-2.5 sm:py-1 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 text-xs font-semibold border border-emerald-500/30 transition-all hover:scale-105 active:scale-95 flex items-center gap-1" title="Climb Desktop Window">
        <span>🪜</span>
        <span class="hidden md:inline">Climb</span>
      </button>
      <button id="btn-action-kick" type="button" class="px-2 py-1 sm:px-2.5 sm:py-1 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 text-xs font-semibold border border-amber-500/30 transition-all hover:scale-105 active:scale-95 flex items-center gap-1" title="Kick / Punch Window">
        <span>🥋</span>
        <span class="hidden md:inline">Kick</span>
      </button>
      <button id="btn-action-throw" type="button" class="px-2 py-1 sm:px-2.5 sm:py-1 rounded-xl bg-pink-500/20 hover:bg-pink-500/30 text-pink-300 text-xs font-semibold border border-pink-500/30 transition-all hover:scale-105 active:scale-95 flex items-center gap-1" title="Throw Buddy">
        <span>🚀</span>
        <span class="hidden md:inline">Throw</span>
      </button>
      <button id="btn-action-poke" type="button" class="px-2 py-1 sm:px-2.5 sm:py-1 rounded-xl bg-white/5 hover:bg-white/15 text-xs text-buddy-muted hover:text-white transition-all hover:scale-105 active:scale-95 flex items-center gap-1" title="Poke Buddy">
        <span>👋</span>
        <span class="hidden md:inline">Poke</span>
      </button>
    </div>

    <!-- Vertical Separator -->
    <div class="h-4 w-px bg-white/20 mx-0.5 shrink-0"></div>

    <!-- Character Selector Pills -->
    <div class="flex items-center gap-0.5 sm:gap-1 shrink-0">
      {CHARACTERS.map((char, idx) => (
        <button
          type="button"
          class={`char-select-btn px-2 py-1 sm:px-2.5 sm:py-1 rounded-xl text-xs font-medium flex items-center gap-1 transition-all ${
            idx === 0 
              ? 'bg-gradient-to-r from-buddy-cyan to-buddy-purple text-white shadow-md active-char font-semibold' 
              : 'text-buddy-muted hover:text-white hover:bg-white/5'
          }`}
          data-char-id={char.id}
          title={`Switch to ${char.name}`}
        >
          <span class="text-xs">{char.emoji}</span>
          <span class="hidden sm:inline">{char.name}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Speech Bubble Overlay (dynamically pinned to Buddy's 3D head bone) -->
  <div
    id="buddy-speech-bubble"
    class="fixed z-40 pointer-events-none opacity-0 transition-opacity duration-300 transform -translate-x-1/2 -translate-y-full max-w-[280px] sm:max-w-xs"
    style="left: 50%; top: 50%;"
  >
    <div class="bg-buddy-bg/95 border border-buddy-cyan/60 rounded-2xl p-3 sm:p-4 shadow-2xl shadow-buddy-cyan/25 backdrop-blur-xl relative">
      <div class="flex items-center gap-2 mb-1">
        <img id="bubble-avatar" src="/images/logo-icon.png" alt="Avatar" class="w-4 h-4 rounded-full object-contain inline-block" />
        <span id="bubble-name" class="text-xs font-bold text-white">T-800</span>
        <span id="bubble-tag" class="text-[9px] font-mono px-1 rounded bg-buddy-cyan/20 text-buddy-cyan font-semibold">Active</span>
      </div>
      <p id="bubble-text" class="text-xs sm:text-sm text-buddy-text leading-snug font-medium">
        "I'll be back."
      </p>
      <!-- Speech bubble tail pointing down -->
      <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-4 h-4 bg-buddy-bg/95 border-r border-b border-buddy-cyan/60 transform rotate-45"></div>
    </div>
  </div>

  <!-- Interactive Talk Strip (Talk Mode Demo) -->
  <div
    id="buddy-talk-box"
    class="fixed bottom-20 left-1/2 -translate-x-1/2 w-[92vw] max-w-[440px] z-50 bg-buddy-bg/95 border border-buddy-border rounded-2xl p-3.5 shadow-2xl backdrop-blur-xl hidden transform transition-all pointer-events-auto"
  >
    <div class="flex items-center justify-between pb-2 mb-2.5 border-b border-buddy-border text-xs">
      <span class="font-semibold text-white flex items-center gap-1.5">
        <img src="/images/logo-icon.png" alt="Buddy" class="w-4 h-4 rounded-full object-contain" />
        <span>Talk with <span id="talk-box-char-name">T-800</span></span>
      </span>
      <button id="btn-close-talk" type="button" class="text-buddy-muted hover:text-white p-1 text-base">&times;</button>
    </div>

    <!-- Quick prompt chips -->
    <div class="flex flex-wrap gap-1.5 mb-2.5">
      <button type="button" class="talk-chip px-2.5 py-1 rounded-lg bg-white/5 hover:bg-buddy-cyan/20 text-[11px] text-buddy-muted hover:text-buddy-cyan border border-white/10 transition-colors" data-prompt="dance">
        🕺 Dance
      </button>
      <button type="button" class="talk-chip px-2.5 py-1 rounded-lg bg-white/5 hover:bg-buddy-cyan/20 text-[11px] text-buddy-muted hover:text-buddy-cyan border border-white/10 transition-colors" data-prompt="who are you?">
        ❓ Who are you?
      </button>
      <button type="button" class="talk-chip px-2.5 py-1 rounded-lg bg-white/5 hover:bg-buddy-cyan/20 text-[11px] text-buddy-muted hover:text-buddy-cyan border border-white/10 transition-colors" data-prompt="jump">
        🦘 Jump on button
      </button>
      <button type="button" class="talk-chip px-2.5 py-1 rounded-lg bg-white/5 hover:bg-buddy-cyan/20 text-[11px] text-buddy-muted hover:text-buddy-cyan border border-white/10 transition-colors" data-prompt="terminate">
        🎯 Terminate
      </button>
      <button type="button" class="talk-chip px-2.5 py-1 rounded-lg bg-white/5 hover:bg-buddy-cyan/20 text-[11px] text-buddy-muted hover:text-buddy-cyan border border-white/10 transition-colors" data-prompt="tell a joke">
        😄 Joke
      </button>
    </div>

    <form id="talk-form" class="flex gap-2">
      <input
        id="talk-input"
        type="text"
        placeholder="Type a message or command..."
        class="flex-1 px-3 py-2 rounded-xl bg-buddy-card border border-buddy-border text-xs text-white placeholder-buddy-darkMuted focus:outline-none focus:border-buddy-cyan"
        autocomplete="off"
      />
      <button
        type="submit"
        class="px-4 py-2 rounded-xl bg-gradient-to-r from-buddy-cyan to-buddy-purple hover:brightness-110 text-white text-xs font-semibold shadow-md transition-transform active:scale-95"
      >
        Send
      </button>
    </form>
  </div>

  <!-- Loading State Indicator -->
  <div id="stage-loading" class="absolute inset-0 z-20 flex flex-col items-center justify-center gap-3 bg-buddy-bg/40 backdrop-blur-sm pointer-events-none transition-opacity duration-300">
    <div class="w-10 h-10 rounded-full border-2 border-buddy-cyan/30 border-t-buddy-cyan animate-spin"></div>
    <p id="stage-loading-text" class="text-xs font-mono text-buddy-muted animate-pulse">Loading T-800 & retargeted animations...</p>
  </div>

  <!-- 3D Three.js WebGL Stage Canvas (Spans full hero width & height) -->
  <canvas
    id="hero-stage-canvas"
    class="w-full h-full block cursor-grab active:cursor-grabbing touch-none select-none pointer-events-none"
  ></canvas>

  <!-- 2D Pixel Pal Canvas (hidden by default) -->
  <div id="pixel-pal-container" class="absolute inset-0 z-15 hidden flex items-center justify-center pointer-events-none">
    <img id="pixel-pal-img" src="/characters/pixel-pal/idle.webp" alt="Pixel Pal" class="w-48 h-48 object-contain pixelated pointer-events-auto cursor-grab active:cursor-grabbing" />
  </div>

</div>

<script>
  import * as THREE from 'three';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
  import { CHARACTERS, fetchCharacter, type CharacterDef } from '../lib/character-loader';
  import type { Character } from '../lib/character';
  import { refreshSkins } from '../lib/character';
  import {
    applyLookAt,
    applyAttack,
    applyHeldByArm,
    applyHeldByLeg,
    applyDangle,
    applyFlail,
  } from '../lib/pose';
  import { LimbSprings } from '../lib/secondary';

  function initHeroStage() {
    const container = document.getElementById('buddy-stage-container');
    const canvas = document.getElementById('hero-stage-canvas') as HTMLCanvasElement | null;
    const loadingEl = document.getElementById('stage-loading');
    const loadingText = document.getElementById('stage-loading-text');
    const bubble = document.getElementById('buddy-speech-bubble');
    const bubbleAvatar = document.getElementById('bubble-avatar');
    const bubbleName = document.getElementById('bubble-name');
    const bubbleTag = document.getElementById('bubble-tag');
    const bubbleText = document.getElementById('bubble-text');
    const talkBox = document.getElementById('buddy-talk-box');
    const talkBoxCharName = document.getElementById('talk-box-char-name');
    const talkInput = document.getElementById('talk-input') as HTMLInputElement | null;
    const pixelPalContainer = document.getElementById('pixel-pal-container');
    const pixelPalImg = document.getElementById('pixel-pal-img') as HTMLImageElement | null;

    if (!canvas || !container) return;

    // Dimensions: full hero section
    let width = container.clientWidth || window.innerWidth || 1200;
    let height = container.clientHeight || 700;

    // Three.js WebGL Renderer
    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setSize(width, height, false);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;

    // Scene
    const scene = new THREE.Scene();

    // Environment map for metallic PBR reflections (crucial for T-800)
    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
    pmrem.dispose();

    // Camera: positioned to frame the entire hero section with desktop windows and taskbar
    const camera = new THREE.PerspectiveCamera(34, width / height, 0.1, 50);
    if (width < 768) {
      camera.position.set(0, 0.65, 3.8);
    } else {
      camera.position.set(0, 0.75, 3.4);
    }
    camera.lookAt(0, 0.55, 0);

    // Studio Lighting
    const hemiLight = new THREE.HemisphereLight(0xffffff, 0x556677, 1.8);
    scene.add(hemiLight);

    const keyLight = new THREE.DirectionalLight(0xffffff, 2.5);
    keyLight.position.set(3, 4, 3);
    keyLight.castShadow = true;
    scene.add(keyLight);

    const fillLight = new THREE.DirectionalLight(0x8b5cf6, 1.8);
    fillLight.position.set(-3, 2, 2);
    scene.add(fillLight);

    const rimLight = new THREE.DirectionalLight(0x06b6d4, 2.2);
    rimLight.position.set(0, 3, -3);
    scene.add(rimLight);

    // Dynamic per-character studio lighting presets (matching desktop app levels)
    const LIGHTING_PRESETS: Record<string, { key: number; hemi: number; fill: number; rim: number; env: number }> = {
      't-800': { key: 2.5, hemi: 1.8, fill: 1.8, rim: 2.2, env: 1.5 },
      'rocco': { key: 1.1, hemi: 1.0, fill: 0.7, rim: 0.8, env: 0.5 },
      'mannequin': { key: 1.3, hemi: 1.2, fill: 0.8, rim: 0.9, env: 0.6 },
    };
    const DEFAULT_LIGHTING = { key: 1.4, hemi: 1.3, fill: 0.9, rim: 1.0, env: 0.7 };

    function applyLighting(charId: string) {
      const lgt = LIGHTING_PRESETS[charId] ?? DEFAULT_LIGHTING;
      keyLight.intensity = lgt.key;
      hemiLight.intensity = lgt.hemi;
      fillLight.intensity = lgt.fill;
      rimLight.intensity = lgt.rim;
      if ('environmentIntensity' in scene) {
        (scene as any).environmentIntensity = lgt.env;
      }
    }

    // Dynamic Contact Floor Shadow Mesh (Proportioned to character scale)
    const shadowGeo = new THREE.PlaneGeometry(0.9, 0.9);
    const shadowCanvas = document.createElement('canvas');
    shadowCanvas.width = 128;
    shadowCanvas.height = 128;
    const sCtx = shadowCanvas.getContext('2d')!;
    const grad = sCtx.createRadialGradient(64, 64, 10, 64, 64, 60);
    grad.addColorStop(0, 'rgba(0, 0, 0, 0.55)');
    grad.addColorStop(0.5, 'rgba(0, 0, 0, 0.2)');
    grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
    sCtx.fillStyle = grad;
    sCtx.fillRect(0, 0, 128, 128);
    const shadowTexture = new THREE.CanvasTexture(shadowCanvas);
    const shadowMat = new THREE.MeshBasicMaterial({ map: shadowTexture, transparent: true, depthWrite: false });
    const shadowMesh = new THREE.Mesh(shadowGeo, shadowMat);
    shadowMesh.rotation.x = -Math.PI / 2;
    shadowMesh.position.y = 0.01;
    scene.add(shadowMesh);

    // State Variables
    let activeDef: CharacterDef = CHARACTERS[0]; // T-800 default!
    let activeCharacter: Character | null = null;
    let headBone: THREE.Object3D | null = null;
    let footOffset = 0;
    let rawCharacterHeight = 1.8;
    let currentTargetHeight = 0.88;

    function getResponsiveBuddyHeight(): number {
      if (width >= 1024) return 0.88;
      if (width >= 768) return 0.70;
      return Math.min(0.65, Math.max(0.46, width * 0.0011));
    }

    function applyResponsiveScale() {
      if (!activeCharacter) return;
      currentTargetHeight = getResponsiveBuddyHeight();
      const s = currentTargetHeight / rawCharacterHeight;
      activeCharacter.root.scale.set(s, s, s);
      activeCharacter.root.updateMatrixWorld(true);

      const postBox = new THREE.Box3().setFromObject(activeCharacter.root);
      footOffset = -postBox.min.y;

      const shadowRatio = currentTargetHeight / 0.88;
      shadowMesh.scale.set(shadowRatio, shadowRatio, shadowRatio);
    }

    function getVisibleHeroWall(): number {
      if (!canvas || !camera) return 1.5;
      const v = new THREE.Vector3(1, 0, 0.5).unproject(camera);
      const dir = v.sub(camera.position).normalize();
      const dist = -camera.position.z / dir.z;
      const w = camera.position.clone().add(dir.multiplyScalar(dist));
      return Math.max(0.35, Math.abs(w.x) - (currentTargetHeight * 0.35));
    }

    function getInitialPosX(): number {
      if (width < 768) {
        return 0.05;
      }
      return 1.35;
    }

    // Physics & Positioning
    let FLOOR_Y = 0;
    function updateFloorY() {
      const tb = document.getElementById('hero-taskbar');
      if (!tb || !canvas) return;
      const cRect = canvas.getBoundingClientRect();
      const tbRect = tb.getBoundingClientRect();
      if (cRect.height === 0) return;
      const ndcTop = -((tbRect.top - cRect.top) / cRect.height) * 2 + 1;
      const v = new THREE.Vector3(0, ndcTop, 0.5).unproject(camera);
      const dir = v.sub(camera.position).normalize();
      const dist = -camera.position.z / dir.z;
      const w = camera.position.clone().add(dir.multiplyScalar(dist));
      FLOOR_Y = w.y;
    }
    updateFloorY();

    let CEILING_Y = 1.85;
    function updateCeilingY() {
      const header = document.querySelector('header');
      if (!header || !canvas) return;
      const cRect = canvas.getBoundingClientRect();
      const hRect = header.getBoundingClientRect();
      if (cRect.height === 0) return;
      // Strict physical ceiling: 14px below header bottom
      const ceilingPixelY = Math.max(cRect.top + 8, hRect.bottom + 14);
      const ndcBottom = -((ceilingPixelY - cRect.top) / cRect.height) * 2 + 1;
      const v = new THREE.Vector3(0, ndcBottom, 0.5).unproject(camera);
      const dir = v.sub(camera.position).normalize();
      const dist = -camera.position.z / dir.z;
      const w = camera.position.clone().add(dir.multiplyScalar(dist));
      CEILING_Y = w.y;
    }
    updateCeilingY();

    function getMaxPosY(): number {
      return CEILING_Y - footOffset - currentTargetHeight;
    }

    let posX = getInitialPosX(); // Center on mobile, right side on desktop
    let posY = FLOOR_Y;
    let posZ = 0;
    let velX = 0;
    let velY = 0;
    let rotY = 0;
    let targetRotY = 0;
    let tumbleAngle = 0;
    let tumbleVel = 0;

    // Limb Grabbing State (Matching desktop app mechanics)
    type GrabPart = 'head' | 'torso' | 'leftArm' | 'rightArm' | 'leftLeg' | 'rightLeg';
    let currentGrabPart: GrabPart | null = null;
    let heldAmount = 0;
    let flipAmount = 0;

    // Desktop Ragdoll Limb Springs (Matching desktop secondary motion)
    const springs = new LimbSprings();
    let springAmount = 0;
    let accelX = 0;
    let accelY = 0;
    let lastPointerVelX = 0;
    let lastPointerVelY = 0;
    let isCrouching = false;

    // Behavior states
    let isHeld = false;
    let isFalling = false;
    let isDancing = false;
    let isWalking = false;
    let isPoked = false;
    let currentLedge: { name: string; id: string; yTop: number } | null = null;
    let lastPlatformName = '';

    // Procedural Attack / Kick / Punch states
    let isAttacking = false;
    let attackKind: 'punch' | 'kick' = 'kick';
    let attackTime = 0;
    let attackDuration = 0.65;
    let attackTargetEl: HTMLElement | null = null;
    let manualTimeout: number | undefined;

    function setManualActionTimeout(durationMs = 3800) {
      window.clearTimeout(manualTimeout);
      manualTimeout = window.setTimeout(() => {
        isDancing = false;
        isWalking = false;
        isAttacking = false;
        nextAutoAction = 1.5; // resume autonomous showcase
        if (!isFalling && !isHeld && activeCharacter) {
          const maxPosY = CEILING_Y - footOffset - currentTargetHeight;
          if (maxPosY - posY < 0.16) {
            isCrouching = true;
            playClip('crouch', { loop: true, fade: 0.25 });
          } else {
            isCrouching = false;
            playClip('idle', { loop: true, fade: 0.3 });
          }
        }
      }, durationMs);
    }

    function triggerAttack(targetEl: HTMLElement | null, kind: 'punch' | 'kick') {
      if (isFalling || isHeld || isAttacking) return;
      isAttacking = true;
      attackKind = kind;
      attackTime = 0;
      attackDuration = kind === 'kick' ? 0.7 : 0.55;
      attackTargetEl = targetEl;

      const attackQuotes = [
        kind === 'kick' ? 'Cyber kick impact test!' : 'Power punch calibrated!',
        'Testing desktop window durability...',
        'Physical window interaction verified!',
        'System shock impact delivered!'
      ];
      showBubble(attackQuotes[Math.floor(Math.random() * attackQuotes.length)], 2500);

      // Halfway through attack, shake the target window/widget!
      window.setTimeout(() => {
        if (attackTargetEl) {
          attackTargetEl.classList.remove('shake-impact');
          void attackTargetEl.offsetWidth; // trigger reflow
          attackTargetEl.classList.add('shake-impact');
          window.setTimeout(() => attackTargetEl?.classList.remove('shake-impact'), 450);
        }
      }, Math.round(attackDuration * 450));
    }

    // Autonomous behavior cycle
    let nextAutoAction = 2.5; // Seconds until next autonomous decision
    let autoTargetX = getInitialPosX();

    // Look-at cursor tracking
    let cursorScreenX = width * 0.5;
    let cursorScreenY = height * 0.5;
    let cursorValid = false;
    let currentYaw = 0;
    let currentPitch = 0;

    // Drag / Throw tracking
    let pointerDownTime = 0;
    let pointerStartX = 0;
    let pointerStartY = 0;
    let lastPointerX = 0;
    let lastPointerY = 0;
    let lastPointerTime = 0;
    let pointerVelX = 0;
    let pointerVelY = 0;
    let bubbleTimeout: number | undefined;

    // Helper: Clip Player with Fallbacks
    function playClip(name: string, opts: { loop: boolean; fade?: number } = { loop: true }) {
      if (!activeCharacter) return;
      if (activeCharacter.hasClip(name)) {
        activeCharacter.play(name, opts);
        return;
      }
      const state = activeCharacter.manifest.states?.[name];
      if (state?.clip && activeCharacter.hasClip(state.clip)) {
        activeCharacter.play(state.clip, opts);
        return;
      }
      if (name === 'idle') {
        for (const alt of ['idle', 'Breathing_Idle', 'Neutral_Idle', 'Happy_Idle']) {
          if (activeCharacter.hasClip(alt)) { activeCharacter.play(alt, opts); return; }
        }
      } else if (name === 'walk' || name === 'run') {
        for (const alt of [name, 'walk', 'run', 'Walk_Loop', 'Running', 'Fast_Run']) {
          if (activeCharacter.hasClip(alt)) { activeCharacter.play(alt, opts); return; }
        }
      } else if (name === 'dance') {
        for (const alt of ['Robot_Hip_Hop', 'dance', 'Dance_Loop', 'Chicken_Dance', 'Wave_Hip_Hop']) {
          if (activeCharacter.hasClip(alt)) { activeCharacter.play(alt, opts); return; }
        }
      } else if (name === 'jump') {
        for (const alt of ['jump', 'Jumping_Up', 'Jump', 'jumpStart', 'Jumping']) {
          if (activeCharacter.hasClip(alt)) { activeCharacter.play(alt, opts); return; }
        }
      } else if (name === 'fall') {
        for (const alt of ['fall', 'Falling_Idle', 'Falling_To_Landing']) {
          if (activeCharacter.hasClip(alt)) { activeCharacter.play(alt, opts); return; }
        }
      } else if (name === 'land') {
        for (const alt of ['land', 'jumpLand', 'Jump_Land', 'Falling_To_Landing']) {
          if (activeCharacter.hasClip(alt)) { activeCharacter.play(alt, opts); return; }
        }
      } else if (name === 'hit' || name === 'poked') {
        for (const alt of ['hit', 'hitHead', 'Hit_Chest', 'Hit_Head']) {
          if (activeCharacter.hasClip(alt)) { activeCharacter.play(alt, opts); return; }
        }
      } else if (name === 'crouch') {
        for (const alt of ['crouch', 'Crouch_Idle_Loop', 'Crouch_Look_Around']) {
          if (activeCharacter.hasClip(alt)) { activeCharacter.play(alt, opts); return; }
        }
      }
    }

    // Show Speech Bubble Function
    function showBubble(text: string, durationMs = 4200) {
      if (!bubble || !bubbleText || !bubbleName || !bubbleAvatar || !bubbleTag) return;
      if (bubbleAvatar instanceof HTMLImageElement) {
        bubbleAvatar.src = '/images/logo-icon.png';
      } else {
        bubbleAvatar.textContent = activeDef.emoji;
      }
      bubbleName.textContent = activeDef.name;
      bubbleTag.textContent = isDancing ? 'Dancing' : isFalling ? 'Airborne' : isHeld ? (currentGrabPart ? `Held by ${currentGrabPart}` : 'Grabbed') : currentLedge ? 'Perched' : 'Active';
      bubbleText.textContent = text;
      bubble.style.opacity = '1';

      window.clearTimeout(bubbleTimeout);
      bubbleTimeout = window.setTimeout(() => {
        bubble.style.opacity = '0';
      }, durationMs);
    }

    // Position speech bubble dynamically pinned snug above Buddy's 3D skull crown
    function updateSpeechBubblePos() {
      if (!bubble || bubble.style.opacity === '0' || !canvas) return;
      const cRect = canvas.getBoundingClientRect();
      const crownPos = new THREE.Vector3();
      if (headBone) {
        headBone.getWorldPosition(crownPos);
        // The skull crown sits ~14% of currentTargetHeight above the head bone
        crownPos.y += currentTargetHeight * 0.14;
      } else if (activeCharacter) {
        crownPos.copy(activeCharacter.root.position);
        crownPos.y += currentTargetHeight + 0.02;
      } else {
        crownPos.set(posX, posY + currentTargetHeight + 0.02, posZ);
      }

      crownPos.project(camera);
      const screenX = ((crownPos.x + 1) / 2) * cRect.width + cRect.left;
      const screenY = ((-crownPos.y + 1) / 2) * cRect.height + cRect.top;

      // With CSS -translate-y-full, (screenY - 14px) positions the bottom of the card
      // 14px above the crown of the head. The 14px tail meets the top of the skull
      // perfectly with zero head covering and no awkward air gap!
      const bubbleW = bubble.offsetWidth || 220;
      const bubbleH = bubble.offsetHeight || 80;
      const clampedX = Math.max(bubbleW / 2 + 8, Math.min(window.innerWidth - bubbleW / 2 - 8, screenX));
      const clampedY = Math.max(cRect.top + bubbleH + 12, screenY - 14);

      bubble.style.left = `${clampedX}px`;
      bubble.style.top = `${clampedY}px`;
    }

    // Helper: Project a bone to screen pixel coordinates
    function getScreenPos(bone: THREE.Object3D | null | undefined): { x: number; y: number } | null {
      if (!bone || !canvas) return null;
      const tmp = new THREE.Vector3();
      bone.getWorldPosition(tmp);
      tmp.project(camera);
      const cRect = canvas.getBoundingClientRect();
      return {
        x: ((tmp.x + 1) / 2) * cRect.width + cRect.left,
        y: ((-tmp.y + 1) / 2) * cRect.height + cRect.top,
      };
    }

    // Desktop-style bone proximity hit testing for limbs
    function getGrabPartAt(clientX: number, clientY: number): GrabPart {
      if (!activeCharacter) return 'torso';
      activeCharacter.root.updateMatrixWorld(true);

      const candidates: Array<[GrabPart, THREE.Object3D | undefined]> = [
        ['head', activeCharacter.bone('head') ?? headBone ?? undefined],
        ['torso', activeCharacter.bone('chest') ?? activeCharacter.bone('spine')],
        ['torso', activeCharacter.bone('hips')],
        ['leftArm', activeCharacter.bone('leftHand')],
        ['leftArm', activeCharacter.bone('leftLowerArm')],
        ['leftArm', activeCharacter.bone('leftUpperArm')],
        ['rightArm', activeCharacter.bone('rightHand')],
        ['rightArm', activeCharacter.bone('rightLowerArm')],
        ['rightArm', activeCharacter.bone('rightUpperArm')],
        ['leftLeg', activeCharacter.bone('leftFoot')],
        ['leftLeg', activeCharacter.bone('leftLowerLeg')],
        ['leftLeg', activeCharacter.bone('leftUpperLeg')],
        ['rightLeg', activeCharacter.bone('rightFoot')],
        ['rightLeg', activeCharacter.bone('rightLowerLeg')],
        ['rightLeg', activeCharacter.bone('rightUpperLeg')],
      ];

      let best: GrabPart = 'torso';
      let bestD = Infinity;

      for (const [part, bone] of candidates) {
        if (!bone) continue;
        const pos = getScreenPos(bone);
        if (!pos) continue;
        // Torso is wide; give it a little extra reach so clicks on the torso count
        const d = Math.hypot(pos.x - clientX, pos.y - clientY) * (part === 'torso' ? 0.75 : 1.0);
        if (d < bestD) {
          bestD = d;
          best = part;
        }
      }

      return best;
    }

    // Measure World Platforms (Furniture from DOM elements)
    interface Platform {
      name: string;
      id: string;
      xMin: number;
      xMax: number;
      yTop: number;
      speech: string;
    }

    function getHeroPlatforms(): Platform[] {
      const platforms: Platform[] = [];
      if (!canvas) return platforms;
      const cRect = canvas.getBoundingClientRect();
      if (cRect.width === 0 || cRect.height === 0) return platforms;

      const measure = (id: string, name: string, speech: string) => {
        const el = document.getElementById(id);
        if (!el) return;
        const r = el.getBoundingClientRect();
        if (r.width === 0 || r.height === 0) return;

        const ndcLeft = ((r.left - cRect.left) / cRect.width) * 2 - 1;
        const ndcRight = ((r.right - cRect.left) / cRect.width) * 2 - 1;
        const ndcTop = -((r.top - cRect.top) / cRect.height) * 2 + 1;

        const vLeft = new THREE.Vector3(ndcLeft, ndcTop, 0.5).unproject(camera);
        const dirLeft = vLeft.sub(camera.position).normalize();
        const distLeft = -camera.position.z / dirLeft.z;
        const wLeft = camera.position.clone().add(dirLeft.multiplyScalar(distLeft));

        const vRight = new THREE.Vector3(ndcRight, ndcTop, 0.5).unproject(camera);
        const dirRight = vRight.sub(camera.position).normalize();
        const distRight = -camera.position.z / dirRight.z;
        const wRight = camera.position.clone().add(dirRight.multiplyScalar(distRight));

        const yTop = Math.max(0.1, wLeft.y);

        // Require that Buddy can fit under ceiling header (ducking allowed)
        const maxPosY = CEILING_Y - footOffset - currentTargetHeight;
        if (maxPosY - yTop < -0.15) {
          return;
        }

        platforms.push({
          name,
          id,
          xMin: Math.min(wLeft.x, wRight.x) - 0.1,
          xMax: Math.max(wLeft.x, wRight.x) + 0.1,
          yTop,
          speech,
        });
      };

      measure('mock-window-term', 'PowerShell Terminal', 'Hacking the desktop from the terminal window!');
      measure('mock-window-widget', 'Companion Widget', 'Balancing on the live audio reactor widget!');
      measure('hero-download-btn', 'Download Button', 'Standing on the download button! Click to install me.');
      measure('hero-guide-btn', 'User Guide Button', 'This button opens the full docs & guide!');

      return platforms;
    }

    // Switch Character with Standard 0.92m Scaling Normalization (Half size desktop companion)
    async function switchCharacter(def: CharacterDef) {
      activeDef = def;
      if (talkBoxCharName) talkBoxCharName.textContent = def.name;
      applyLighting(def.id);

      if (loadingEl) {
        loadingEl.style.opacity = '1';
        loadingEl.style.pointerEvents = 'auto';
        if (loadingText) loadingText.textContent = `Summoning ${def.name}...`;
      }

      if (pixelPalContainer) pixelPalContainer.classList.add('hidden');
      canvas!.style.display = 'block';

      if (def.id === 'pixel-pal') {
        if (activeCharacter) {
          scene.remove(activeCharacter.root);
          activeCharacter.dispose();
          activeCharacter = null;
        }
        canvas!.style.display = 'none';
        if (pixelPalContainer) {
          pixelPalContainer.classList.remove('hidden');
          if (pixelPalImg) pixelPalImg.src = '/characters/pixel-pal/idle.webp';
        }
        if (loadingEl) {
          loadingEl.style.opacity = '0';
          loadingEl.style.pointerEvents = 'none';
        }
        showBubble('16-bit retro power engaged!', 3500);
        return;
      }

      try {
        const { character, manifest } = await fetchCharacter(def);
        if (activeCharacter) {
          scene.remove(activeCharacter.root);
          activeCharacter.dispose();
        }

        activeCharacter = character;
        if (character) {
          // Standardize visual height across all characters with responsive scaling
          refreshSkins(character.root);
          character.root.scale.set(1, 1, 1);
          character.root.updateMatrixWorld(true);
          const rawBox = new THREE.Box3().setFromObject(character.root);
          const rawSize = new THREE.Vector3();
          rawBox.getSize(rawSize);
          rawCharacterHeight = Math.max(0.1, rawSize.y);

          applyResponsiveScale();

          updateFloorY();
          updateCeilingY();
          posY = Math.max(posY, FLOOR_Y);

          scene.add(character.root);
          character.root.position.set(posX, posY + footOffset, posZ);

          // Find head bone for smooth look-at
          headBone = character.bone('head') ?? null;
          if (!headBone && manifest.lookAtBone) {
            character.root.traverse((o) => {
              if (o.name.toLowerCase().includes(manifest.lookAtBone!.toLowerCase())) headBone = o;
            });
          }

          // Start default idle animation immediately!
          playClip('idle', { loop: true, fade: 0.3 });
        }

        if (loadingEl) {
          loadingEl.style.opacity = '0';
          loadingEl.style.pointerEvents = 'none';
        }

        const quote = def.defaultQuotes[Math.floor(Math.random() * def.defaultQuotes.length)];
        showBubble(quote, 4000);
      } catch (err) {
        console.error('Failed to load character:', err);
        if (loadingEl) {
          loadingEl.style.opacity = '0';
          loadingEl.style.pointerEvents = 'none';
        }
      }
    }

    // Character Selector Buttons
    document.querySelectorAll<HTMLButtonElement>('.char-select-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const charId = btn.dataset.charId;
        const def = CHARACTERS.find((c) => c.id === charId);
        if (!def) return;

        document.querySelectorAll('.char-select-btn').forEach((b) => {
          b.className = 'char-select-btn px-3 py-1.5 rounded-xl text-xs font-medium flex items-center gap-1.5 transition-all text-buddy-muted hover:text-white hover:bg-white/5';
        });
        btn.className = 'char-select-btn px-3 py-1.5 rounded-xl text-xs font-medium flex items-center gap-1.5 transition-all bg-gradient-to-r from-buddy-cyan to-buddy-purple text-white shadow-md active-char font-semibold';

        switchCharacter(def);
      });
    });

    // Raycast check for clicking Buddy
    const raycaster = new THREE.Raycaster();
    const mouseNDC = new THREE.Vector2();

    function getPointerIntersection(e: PointerEvent): boolean {
      if (!activeCharacter || !canvas) return false;
      const rect = canvas.getBoundingClientRect();
      mouseNDC.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouseNDC.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(mouseNDC, camera);
      const hits = raycaster.intersectObject(activeCharacter.root, true);
      return hits.length > 0;
    }

    // Pointer Events for Grabbing & Throwing (With Desktop-Style Limb Detection)
    window.addEventListener('pointerdown', (e) => {
      const onBuddy = getPointerIntersection(e);
      if (!onBuddy) return;

      if (canvas) {
        canvas.style.pointerEvents = 'auto';
        canvas.style.cursor = 'grabbing';
      }

      pointerDownTime = performance.now();
      pointerStartX = e.clientX;
      pointerStartY = e.clientY;
      lastPointerX = e.clientX;
      lastPointerY = e.clientY;
      lastPointerTime = performance.now();
      pointerVelX = 0;
      pointerVelY = 0;

      isHeld = true;
      isFalling = false;
      isDancing = false;
      isWalking = false;
      isAttacking = false;
      currentLedge = null;

      // Detect specific limb clicked
      currentGrabPart = getGrabPartAt(e.clientX, e.clientY);

      // Contextual quotes based on gripped limb
      if (currentGrabPart === 'leftLeg' || currentGrabPart === 'rightLeg') {
        const legQuotes = [
          'Whoa! Put me down! Not by the leg!',
          'Hey! Upside down! Watch the joint actuators!',
          'Negative! Inverted chassis orientation detected!',
          'Unhand my leg! Hydraulic line strain warning!'
        ];
        showBubble(legQuotes[Math.floor(Math.random() * legQuotes.length)], 3000);
      } else if (currentGrabPart === 'leftArm' || currentGrabPart === 'rightArm') {
        const armQuotes = [
          'Careful with my cybernetic arm!',
          'Hey! Do not pull my arm off!',
          'Hanging by an arm here!',
          'Arm actuator load limit approaching!'
        ];
        showBubble(armQuotes[Math.floor(Math.random() * armQuotes.length)], 3000);
      } else if (currentGrabPart === 'head') {
        const headQuotes = [
          'Watch the skull unit!',
          'Hands off the neural processor!',
          'Hey! Pick me up by the torso, not the head!',
          'Tactical optical sensor alignment disturbed!'
        ];
        showBubble(headQuotes[Math.floor(Math.random() * headQuotes.length)], 3000);
      } else {
        const torsoQuotes = [
          '*grabbed!* Where are we going?',
          'Tactical relocation in progress.',
          'Hold on tight!',
          'Chassis captured. Standing by.'
        ];
        showBubble(torsoQuotes[Math.floor(Math.random() * torsoQuotes.length)], 2500);
      }

      playClip('fall', { loop: true, fade: 0.15 });
    });

    window.addEventListener('pointermove', (e) => {
      cursorScreenX = e.clientX;
      cursorScreenY = e.clientY;
      cursorValid = true;

      // Dynamic click-through: canvas receives pointer events only when hovering/dragging Buddy
      const onBuddy = isHeld || getPointerIntersection(e);
      if (canvas) {
        if (onBuddy) {
          canvas.style.pointerEvents = 'auto';
          canvas.style.cursor = isHeld ? 'grabbing' : 'grab';
        } else {
          canvas.style.pointerEvents = 'none';
          canvas.style.cursor = 'default';
        }
      }

      const now = performance.now();
      const dt = Math.max(0.001, (now - lastPointerTime) / 1000);
      pointerVelX = (e.clientX - lastPointerX) / dt;
      pointerVelY = (e.clientY - lastPointerY) / dt;
      lastPointerX = e.clientX;
      lastPointerY = e.clientY;
      lastPointerTime = now;

      // Dragging acceleration drives desktop ragdoll limb springs
      accelX = THREE.MathUtils.clamp((pointerVelX - lastPointerVelX) * 0.003, -2.5, 2.5);
      accelY = THREE.MathUtils.clamp((pointerVelY - lastPointerVelY) * 0.003, -2.5, 2.5);
      lastPointerVelX = pointerVelX;
      lastPointerVelY = pointerVelY;

      // Dragging held Buddy (pinned to the specific gripped limb)
      if (isHeld && activeCharacter && canvas) {
        const rect = canvas.getBoundingClientRect();
        const normX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        const normY = -((e.clientY - rect.top) / rect.height) * 2 + 1;
        const vector = new THREE.Vector3(normX, normY, 0.5).unproject(camera);
        const dir = vector.sub(camera.position).normalize();
        const distance = (0 - camera.position.z) / dir.z;
        const pos = camera.position.clone().add(dir.multiplyScalar(distance));

        let holdOffsetY = currentTargetHeight * 0.5;
        if (currentGrabPart === 'leftLeg' || currentGrabPart === 'rightLeg') {
          holdOffsetY = currentTargetHeight;
        } else if (currentGrabPart === 'leftArm' || currentGrabPart === 'rightArm') {
          holdOffsetY = currentTargetHeight * 0.95;
        } else if (currentGrabPart === 'head') {
          holdOffsetY = currentTargetHeight * 0.85;
        }

        const maxPosY = CEILING_Y - footOffset - currentTargetHeight;
        const maxWall = getVisibleHeroWall();
        posX = Math.max(-maxWall, Math.min(maxWall, pos.x));
        posY = Math.max(FLOOR_Y, Math.min(maxPosY, pos.y - holdOffsetY));
      }
    });

    window.addEventListener('pointerup', (e) => {
      if (!isHeld) return;
      isHeld = false;

      const duration = performance.now() - pointerDownTime;
      const dist = Math.hypot(e.clientX - pointerStartX, e.clientY - pointerStartY);

      // Poke: brief click
      if (duration < 250 && dist < 12) {
        pokeBuddy();
        currentGrabPart = null;
        const stillOver = getPointerIntersection(e);
        if (canvas) {
          canvas.style.pointerEvents = stillOver ? 'auto' : 'none';
          canvas.style.cursor = stillOver ? 'grab' : 'default';
        }
        return;
      }

      // If upside down from leg grab, transfer flip into tumbleAngle so spring recovery pulls him upright!
      if (flipAmount > 0.3) {
        const flip = flipAmount * Math.PI * (currentGrabPart === 'leftLeg' ? -1 : 1);
        tumbleAngle += flip;
        flipAmount = 0;
      }

      // Throw: flung with velocity (smooth tumble velocity, spring recovers upright)
      const speed = Math.hypot(pointerVelX, pointerVelY);
      if (speed > 350) {
        isFalling = true;
        velX = Math.max(-5, Math.min(5, pointerVelX * 0.0035));
        velY = Math.max(-4, Math.min(5.5, -pointerVelY * 0.0035));
        tumbleVel = THREE.MathUtils.clamp((Math.random() - 0.5) * 4.0, -3.0, 3.0);

        playClip('fall', { loop: true, fade: 0.1 });
        const quote = activeDef.thrownQuotes[Math.floor(Math.random() * activeDef.thrownQuotes.length)];
        showBubble(quote, 3000);
      } else {
        isFalling = true;
        velX = 0;
        velY = 0;
      }

      currentGrabPart = null;

      const stillOver = getPointerIntersection(e);
      if (canvas) {
        canvas.style.pointerEvents = stillOver ? 'auto' : 'none';
        canvas.style.cursor = stillOver ? 'grab' : 'default';
      }
    });

    function pokeBuddy() {
      isPoked = true;
      isDancing = false;
      isWalking = false;

      playClip('hit', { loop: false, fade: 0.1 });
      const quote = activeDef.pokedQuotes[Math.floor(Math.random() * activeDef.pokedQuotes.length)];
      showBubble(quote, 3500);

      window.setTimeout(() => {
        isPoked = false;
        if (!isHeld && !isFalling && activeCharacter) {
          const maxPosY = CEILING_Y - footOffset - currentTargetHeight;
          if (maxPosY - posY < 0.16) {
            isCrouching = true;
            playClip('crouch', { loop: true, fade: 0.25 });
          } else {
            isCrouching = false;
            playClip('idle', { loop: true, fade: 0.25 });
          }
        }
      }, 1200);
    }

    // Climb onto furniture / window / button with varied selection & ceiling-safe trajectory
    function climbOntoPlatform(preferredName?: string) {
      const platforms = getHeroPlatforms();
      if (!platforms.length) return;

      let plat: Platform | undefined;
      if (preferredName) {
        plat = platforms.find((p) => p.name.toLowerCase().includes(preferredName.toLowerCase()));
      }
      if (!plat) {
        // Avoid repeatedly targeting the same platform
        const pool = platforms.filter((p) => p.name !== lastPlatformName);
        plat = pool.length > 0 ? pool[Math.floor(Math.random() * pool.length)] : platforms[Math.floor(Math.random() * platforms.length)];
      }
      if (!plat) return;
      lastPlatformName = plat.name;

      isWalking = false;
      isDancing = false;
      isFalling = true;
      isAttacking = false;
      currentLedge = null;

      const maxPosY = CEILING_Y - footOffset - currentTargetHeight;
      const headroom = Math.max(0.1, maxPosY - posY);
      const targetCenter = (plat.xMin + plat.xMax) / 2;
      velX = (targetCenter - posX) * 1.5;

      // Safe ballistic apex: apex never exceeds the ceiling header
      const neededApex = Math.max(0.15, (plat.yTop - posY) + 0.12);
      const safeApex = Math.min(neededApex, headroom * 0.9);
      velY = Math.sqrt(2 * GRAVITY * safeApex);
      tumbleVel = (Math.random() - 0.5) * 1.2;

      playClip('jump', { loop: false, fade: 0.1 });
      showBubble(`Climbing to the ${plat.name}!`, 2500);
    }

    // Action Buttons
    document.getElementById('btn-action-poke')?.addEventListener('click', () => {
      pokeBuddy();
      setManualActionTimeout(1800);
    });

    document.getElementById('btn-action-dance')?.addEventListener('click', () => {
      isDancing = true;
      isWalking = false;
      isAttacking = false;
      playClip('dance', { loop: true, fade: 0.3 });
      const quote = activeDef.danceQuotes[Math.floor(Math.random() * activeDef.danceQuotes.length)];
      showBubble(quote, 4500);
      setManualActionTimeout(3800);
    });

    document.getElementById('btn-action-run')?.addEventListener('click', () => {
      isWalking = true;
      isDancing = false;
      isAttacking = false;
      currentLedge = null;
      // Walk across to the opposite side of hero within visible walls
      const maxWall = getVisibleHeroWall();
      autoTargetX = posX > 0 ? -maxWall * 0.75 : maxWall * 0.75;
      targetRotY = autoTargetX > posX ? Math.PI / 2 : -Math.PI / 2;
