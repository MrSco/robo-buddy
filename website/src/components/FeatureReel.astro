<section id="demos" class="py-20 border-t border-buddy-border/80 bg-buddy-bg/50 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-buddy-purple/30 bg-buddy-purple/10 text-buddy-purpleLight text-xs font-semibold uppercase tracking-wider mb-4">
        <span>Desktop Feature Reel</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        See Robo Buddy in <span class="text-gradient">Action</span>
      </h2>
      <p class="mt-3 text-sm sm:text-base text-buddy-muted">
        Watch how physics, audio analysis, webcam tracking, and contextual AI come together on the Windows desktop.
      </p>
    </div>

    <!-- Feature Reel Container -->
    <div class="bg-buddy-card border border-buddy-border rounded-2xl p-4 sm:p-6 lg:p-8 shadow-2xl">
      <!-- Tabs Navigation -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 border-b border-buddy-border scrollbar-thin">
        {features.map((feat, idx) => (
          <button
            type="button"
            class={`reel-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-medium whitespace-nowrap transition-all flex items-center gap-2 ${idx === 0 ? 'bg-gradient-to-r from-buddy-cyan to-buddy-purple text-white shadow-md' : 'bg-buddy-bg border border-buddy-border text-buddy-muted hover:text-white hover:border-buddy-borderLight'}`}
            data-target={feat.id}
          >
            <span>{feat.tab}</span>
          </button>
        ))}
      </div>

      <!-- Feature Content Panels -->
      <div class="mt-8">
        {features.map((feat, idx) => (
          <div
            id={`panel-${feat.id}`}
            class={`reel-panel grid grid-cols-1 lg:grid-cols-12 gap-8 items-center ${idx === 0 ? 'block' : 'hidden'}`}
          >
            <!-- Left Info Column -->
            <div class="lg:col-span-5 space-y-5">
              <div class="flex items-center gap-2">
                <span class={`text-[11px] font-mono px-2.5 py-0.5 rounded-full border font-semibold ${feat.badgeColor}`}>
                  {feat.badge}
                </span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight leading-snug">
                {feat.title}
              </h3>
              <p class="text-sm text-buddy-muted leading-relaxed">
                {feat.description}
              </p>
              <ul class="space-y-2.5 pt-2">
                {feat.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-buddy-text">
                    <span class="text-buddy-cyan text-base leading-none">✓</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
              <div class="pt-4">
                <a href={`/guide#${feat.id}`} class="inline-flex items-center gap-2 text-xs font-semibold text-buddy-cyan hover:text-buddy-cyanLight transition-colors">
                  <span>Read chapter in guide</span>
                  <span>→</span>
                </a>
              </div>
            </div>

            <!-- Right Video Player Mockup Column -->
            <div class="lg:col-span-7">
              <div class="rounded-xl border border-buddy-border bg-black/60 shadow-xl overflow-hidden relative group">
                <!-- Mockup OS Window Header -->
                <div class="h-8 bg-buddy-bg border-b border-buddy-border/80 flex items-center justify-between px-3">
                  <div class="flex items-center gap-1.5">
                    <div class="w-2.5 h-2.5 rounded-full bg-red-500/70"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/70"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/70"></div>
                  </div>
                  <span class="text-[11px] font-mono text-buddy-darkMuted">demo_{feat.id}_capture.mp4</span>
                  <div class="text-[10px] font-mono text-buddy-cyan px-1.5 py-0.5 rounded bg-buddy-cyan/10">1080p 60fps</div>
                </div>

                <!-- Video Viewport / Ready-to-drop placeholder -->
                <div class="aspect-video relative bg-gradient-to-br from-buddy-bg via-[#0c1220] to-[#121b2d] flex flex-col items-center justify-center p-6 text-center overflow-hidden">
                  <!-- Subtle Scanline effect -->
                  <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(#22d3ee_1px,transparent_1px)] [background-size:16px_16px] opacity-10"></div>
                  
                  <!-- Video element (loads user video if present, otherwise shows placeholder) -->
                  <video
                    class="absolute inset-0 w-full h-full object-cover hidden"
                    controls
                    preload="metadata"
                    src={feat.videoFile}
                  ></video>

                  <!-- Placeholder Overlay -->
                  <div class="relative z-10 flex flex-col items-center max-w-md space-y-3">
                    <div class="w-16 h-16 rounded-full bg-gradient-to-tr from-buddy-cyan to-buddy-purple p-0.5 shadow-xl group-hover:scale-110 transition-transform">
                      <div class="w-full h-full bg-buddy-bg/90 rounded-full flex items-center justify-center text-buddy-cyan text-xl pl-1">
                        ▶
                      </div>
                    </div>
                    <div>
                      <h4 class="text-sm font-semibold text-white">{feat.videoPoster}</h4>
                      <p class="text-xs text-buddy-darkMuted mt-1">
                        Video placeholder ready for desktop screen recording
