                      <code class="mt-2 inline-block text-[10px] font-mono px-2 py-1 rounded bg-white/5 border border-white/10 text-buddy-cyan">
                        Drop into: public{feat.videoFile}
                      </code>
                    </div>
                  </div>

                  <!-- Fake Video Player Controls Bar at bottom -->
                  <div class="absolute bottom-0 inset-x-0 h-10 bg-gradient-to-t from-black/90 to-transparent px-4 flex items-center justify-between z-10">
                    <div class="flex items-center gap-3 text-xs text-buddy-muted font-mono">
                      <span class="text-white hover:text-buddy-cyan cursor-pointer">▶</span>
                      <span>0:00 / 0:45</span>
                    </div>
                    <div class="flex-1 mx-4 h-1 bg-white/10 rounded-full overflow-hidden">
                      <div class="w-1/3 h-full bg-gradient-to-r from-buddy-cyan to-buddy-purple rounded-full"></div>
                    </div>
                    <div class="flex items-center gap-3 text-xs text-buddy-muted">
                      <span>🔊</span>
                      <span>HD</span>
                      <span>⛶</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initFeatureReel() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.reel-tab');
    const panels = document.querySelectorAll<HTMLElement>('.reel-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.target;
        if (!target) return;

        // Update tabs styling
        tabs.forEach((t) => {
          t.classList.remove('bg-gradient-to-r', 'from-buddy-cyan', 'to-buddy-purple', 'text-white', 'shadow-md');
          t.classList.add('bg-buddy-bg', 'border', 'border-buddy-border', 'text-buddy-muted');
        });
        tab.classList.add('bg-gradient-to-r', 'from-buddy-cyan', 'to-buddy-purple', 'text-white', 'shadow-md');
        tab.classList.remove('bg-buddy-bg', 'border', 'border-buddy-border', 'text-buddy-muted');

        // Toggle panels
        panels.forEach((p) => {
          if (p.id === `panel-${target}`) {
            p.classList.remove('hidden');
            p.classList.add('block');
          } else {
            p.classList.add('hidden');
            p.classList.remove('block');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeatureReel);
  } else {
    initFeatureReel();
  }
</script>
