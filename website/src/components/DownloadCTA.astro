---
---

<section id="download" class="py-24 relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-buddy-border bg-gradient-to-b from-buddy-card via-buddy-card to-[#0d1424] p-8 sm:p-12 lg:p-16 text-center relative shadow-2xl overflow-hidden">
      <!-- Glow background -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-buddy-cyan/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-buddy-cyan/30 bg-buddy-cyan/10 text-buddy-cyan text-xs font-semibold uppercase tracking-wider">
          <span>Ready for Windows 10 & 11</span>
        </div>

        <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          Bring Robo Buddy to Your Desktop Today
        </h2>

        <p class="text-sm sm:text-base text-buddy-muted max-w-2xl mx-auto leading-relaxed">
          Lightweight, free, and open source. Installs per-user with no administrative hurdles and lives quietly in your system tray.
        </p>

        <!-- Main Download Action Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="https://github.com/MrSco/robo-buddy-releases/releases/latest/download/RoboBuddy-Setup-0.6.0.exe"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-buddy-cyan to-buddy-purple hover:brightness-110 text-white font-bold text-base shadow-xl shadow-buddy-cyan/25 transition-all hover:scale-105 active:scale-95 flex items-center justify-center gap-3"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.951-1.77"/></svg>
            <span>Download for Windows (.exe)</span>
          </a>

          <a
            href="https://github.com/MrSco/robo-buddy-releases/releases/latest/download/RoboBuddy-0.6.0.msi"
            class="w-full sm:w-auto px-6 py-4 rounded-xl bg-buddy-bg border border-buddy-border hover:border-buddy-cyan/50 text-buddy-text hover:text-white font-medium text-sm transition-all hover:bg-white/5 flex items-center justify-center gap-2"
          >
            <span>Download .msi Package</span>
          </a>
        </div>

        <!-- System Requirements & Specs -->
        <div class="pt-6 flex flex-wrap items-center justify-center gap-y-2 gap-x-6 text-xs text-buddy-muted">
          <span class="flex items-center gap-1.5">
            <span class="text-buddy-cyan">✓</span> Windows 10/11 (64-bit)
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-buddy-cyan">✓</span> Built-in WebView2 Runtime
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-buddy-cyan">✓</span> 100% Free & Open Source
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-buddy-cyan">✓</span> Clean Uninstall via Windows Settings
          </span>
        </div>

        <div class="pt-2 text-xs text-buddy-darkMuted font-mono">
          Looking for past builds or source releases? <a href="https://github.com/MrSco/robo-buddy-releases" target="_blank" rel="noopener noreferrer" class="text-buddy-cyan hover:underline">View GitHub Releases &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</section>
