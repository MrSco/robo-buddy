---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuddyHeroStage from '../components/BuddyHeroStage.astro';
import FeatureReel from '../components/FeatureReel.astro';
import ClippyShowcase from '../components/ClippyShowcase.astro';
import BentoGrid from '../components/BentoGrid.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
---

<BaseLayout currentPath="/">
  <!-- ==================== HERO SECTION (UNBOXED FULL HERO BUDDY) ==================== -->
  <section id="hero-section" class="relative min-h-[640px] sm:min-h-[720px] lg:min-h-[800px] pt-6 pb-14 sm:pt-14 sm:pb-24 overflow-hidden">
    <!-- Full-Width Interactive 3D Hero Stage -->
    <BuddyHeroStage />

    <!-- Hero Content (Behind 3D stage so Buddy renders in front of text and elements) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
        <!-- Left Hero Copy -->
        <div class="lg:col-span-6 space-y-4 sm:space-y-6 text-center lg:text-left pt-6 sm:pt-0">
          <!-- Release Badge (Climbable Platform) -->
          <div id="hero-badge-platform" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-buddy-border bg-buddy-card/85 text-xs text-buddy-muted shadow-sm backdrop-blur-md pointer-events-auto">
            <span class="w-2 h-2 rounded-full bg-buddy-cyan animate-pulse"></span>
            <span class="text-white font-medium">Robo Buddy 0.6.0 is here</span>
            <span class="text-buddy-darkMuted">•</span>
            <a href="/guide" class="text-buddy-cyan hover:underline cursor-pointer">What's new &rarr;</a>
          </div>

          <!-- Main Title -->
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.15] sm:leading-[1.1] pointer-events-none">
            The Desktop Pet, <br />
            <span class="text-gradient">Reimagined</span> for the AI Era.
          </h1>

          <!-- Subtitle -->
          <p class="text-sm sm:text-base lg:text-lg text-buddy-muted max-w-xl mx-auto lg:mx-0 leading-relaxed pointer-events-none">
            He lives on your taskbar, watches your cursor, and dances to whatever plays through your speakers. Throw him across your screen, watch him climb your windows, or chat with offline neural voices.
          </p>

          <!-- CTAs (Climbable Furniture Platforms for Buddy) -->
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pointer-events-auto">
            <a
              id="hero-download-btn"
              href="#download"
              class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-gradient-to-r from-buddy-cyan to-buddy-purple hover:brightness-110 text-white font-bold text-sm shadow-xl shadow-buddy-cyan/20 transition-all hover:scale-105 active:scale-95 flex items-center justify-center gap-2.5"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.951-1.77"/></svg>
              <span>Download for Windows</span>
            </a>

            <a
              id="hero-guide-btn"
              href="/guide"
              class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-buddy-card/85 border border-buddy-border hover:border-buddy-cyan/50 text-buddy-text hover:text-white font-medium text-sm transition-all hover:bg-white/5 flex items-center justify-center gap-2 shadow-lg"
            >
              <span>Explore User Guide</span>
              <span>&rarr;</span>
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="pt-4 flex flex-wrap items-center justify-center lg:justify-start gap-y-2 gap-x-6 text-xs text-buddy-darkMuted font-mono pointer-events-none">
            <span>Windows 10/11</span>
            <span>•</span>
            <span>100% Free & Open Source</span>
            <span>•</span>
            <span>No Telemetry / Offline First</span>
          </div>
        </div>

        <!-- Center & Right Mock Desktop Windows (Windows 11 Skin, Climbable & Punchable) -->
        <div class="lg:col-span-6 flex flex-col sm:flex-row items-end justify-center lg:justify-end gap-3 sm:gap-4 min-h-[200px] sm:min-h-[360px] pointer-events-none pt-4 sm:pt-12 pb-2 mt-auto">
          <!-- Center Mock Widget: Windows 11 Robo Buddy Companion Card / Mobile Tabbed Window -->
          <div
            id="mock-window-widget"
            class="mock-desktop-window w-full sm:w-60 lg:w-64 rounded-lg bg-[#161616]/95 border border-white/15 shadow-2xl backdrop-blur-2xl overflow-hidden transition-all duration-200 hover:scale-[1.01] pointer-events-auto select-none"
            title="Robo Buddy Companion Status (Climb or kick this window!)"
          >
            <!-- Windows 11 Title Bar with Mobile Tabs -->
            <div class="flex items-center justify-between px-2.5 py-1.5 bg-[#202020]/90 border-b border-white/10 text-xs">
              <div class="flex items-center gap-1 sm:gap-1.5 text-[11px] font-medium text-white">
                <!-- Desktop title (hidden on mobile) -->
                <div class="hidden sm:flex items-center gap-1.5">
                  <img src="/images/logo-icon.png" alt="Robo Buddy" class="w-3.5 h-3.5 object-contain rounded" />
                  <span>Robo Buddy</span>
                </div>
                <!-- Mobile Tabs (shown on mobile to switch between Companion and Terminal without stacking two huge windows) -->
                <div class="flex sm:hidden items-center gap-1 font-mono text-[10px]">
                  <button id="tab-btn-companion" type="button" class="px-2 py-0.5 rounded bg-[#161616] text-white border-t border-buddy-cyan font-sans font-medium flex items-center gap-1">
                    <img src="/images/logo-icon.png" alt="" class="w-3 h-3 object-contain rounded" />
                    <span>Companion</span>
                  </button>
                  <button id="tab-btn-terminal" type="button" class="px-2 py-0.5 rounded text-buddy-muted hover:text-white flex items-center gap-1 font-sans">
                    <span>PowerShell</span>
                  </button>
                </div>
              </div>
              <!-- Windows 11 Title Controls -->
              <div class="flex items-center text-buddy-muted">
                <span class="w-6 h-5 flex items-center justify-center hover:bg-white/10 hover:text-white cursor-pointer transition-colors" title="Minimize">
                  <svg class="w-2.5 h-2.5" viewBox="0 0 10 10" stroke="currentColor"><line x1="0" y1="5" x2="10" y2="5" stroke-width="1.2"/></svg>
                </span>
                <span class="w-6 h-5 flex items-center justify-center hover:bg-red-600 hover:text-white cursor-pointer transition-colors" title="Close">
                  <svg class="w-2.5 h-2.5" viewBox="0 0 10 10" stroke="currentColor"><line x1="0" y1="0" x2="10" y2="10" stroke-width="1.2"/><line x1="10" y1="0" x2="0" y2="10" stroke-width="1.2"/></svg>
                </span>
              </div>
            </div>

            <!-- Companion Body (WASAPI) -->
            <div id="companion-tab-content" class="p-3 text-xs space-y-2">
              <!-- Audio Reactor Status -->
              <div class="p-2 rounded bg-white/5 border border-white/5">
                <div class="flex items-center justify-between text-[11px] font-medium mb-1">
                  <span class="text-white flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>WASAPI Loopback</span>
                  </span>
                  <span class="font-mono text-[10px] text-buddy-cyan px-1 rounded bg-buddy-cyan/10">128 BPM</span>
                </div>
                <p class="text-[10px] text-buddy-muted truncate">Daft Punk &bull; Robot Rock</p>
                <!-- Animated EQ bars -->
                <div class="flex items-end gap-1 h-4 pt-1">
                  <span class="w-1.5 bg-buddy-cyan rounded-full animate-bounce h-3.5"></span>
                  <span class="w-1.5 bg-buddy-purple rounded-full animate-pulse h-4"></span>
                  <span class="w-1.5 bg-buddy-cyan rounded-full animate-bounce h-2.5" style="animation-delay: 0.15s;"></span>
                  <span class="w-1.5 bg-pink-500 rounded-full animate-pulse h-4" style="animation-delay: 0.25s;"></span>
                  <span class="w-1.5 bg-emerald-400 rounded-full animate-bounce h-3.5" style="animation-delay: 0.1s;"></span>
                </div>
              </div>

              <!-- Desktop Settings Indicators -->
              <div class="grid grid-cols-2 gap-1.5 text-[10px] font-mono">
                <div class="px-2 py-1 rounded bg-white/5 border border-white/5 flex items-center justify-between text-buddy-muted">
                  <span>Surface</span>
                  <span class="text-emerald-400 font-bold">SOLID</span>
                </div>
                <div class="px-2 py-1 rounded bg-white/5 border border-white/5 flex items-center justify-between text-buddy-muted">
                  <span>Physics</span>
                  <span class="text-buddy-cyan font-bold">ACTIVE</span>
                </div>
              </div>
              <div class="text-[10px] text-buddy-darkMuted text-center font-mono">
                Buddy hops on &amp; kicks this window
              </div>
            </div>

            <!-- Mobile Terminal Content (shown when PowerShell tab selected on mobile) -->
            <div id="mobile-terminal-tab-content" class="hidden p-2.5 font-mono text-[10px] leading-relaxed text-buddy-muted space-y-1 bg-[#0c0c0c]">
              <div class="text-white/80">Windows PowerShell 7.4</div>
              <div class="text-emerald-400">PS C:\RoboBuddy&gt; .\robo-buddy.exe --live</div>
              <div class="text-buddy-cyan">✓ Direct3D 11 active &bull; WASAPI syncd</div>
              <div class="text-emerald-400">✓ Collision furniture mapped</div>
              <div class="text-white/60 text-[9px] pt-0.5 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-buddy-cyan animate-ping"></span>
                <span>Buddy roaming perimeter...</span>
              </div>
            </div>
          </div>

          <!-- Right Mock Window: Windows 11 Command Terminal (Shown on tablet and desktop >= 640px) -->
          <div
            id="mock-window-term"
            class="mock-desktop-window hidden sm:block w-full sm:w-80 lg:w-96 rounded-lg bg-[#0c0c0c]/95 border border-white/15 shadow-2xl backdrop-blur-2xl overflow-hidden transition-all duration-200 hover:scale-[1.01] pointer-events-auto select-none"
            title="Desktop Terminal Window (Climb and kick target!)"
          >
            <!-- Windows 11 Title Bar -->
            <div class="flex items-center justify-between px-3 py-1.5 bg-[#1f1f1f]/90 border-b border-white/10 text-xs">
              <!-- Tab Header -->
              <div class="flex items-center gap-2 px-2.5 py-0.5 bg-[#0c0c0c] rounded-t border-t border-buddy-cyan text-[11px] font-mono text-white">
                <svg class="w-3 h-3 text-buddy-cyan" fill="currentColor" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm0 2v12h16V6H4zm2 2h2v2H6V8zm0 4h10v2H6v-2z"/></svg>
                <span>Windows PowerShell</span>
              </div>
              <!-- Windows 11 Window Controls (Top Right) -->
              <div class="flex items-center text-buddy-muted">
                <span class="w-7 h-5 flex items-center justify-center hover:bg-white/10 hover:text-white cursor-pointer transition-colors" title="Minimize">
                  <svg class="w-2.5 h-2.5" viewBox="0 0 10 10" stroke="currentColor"><line x1="0" y1="5" x2="10" y2="5" stroke-width="1.2"/></svg>
                </span>
                <span class="w-7 h-5 flex items-center justify-center hover:bg-white/10 hover:text-white cursor-pointer transition-colors" title="Maximize">
                  <svg class="w-2.5 h-2.5" viewBox="0 0 10 10" stroke="currentColor" fill="none"><rect x="0.5" y="0.5" width="9" height="9" stroke-width="1.2"/></svg>
                </span>
                <span class="w-7 h-5 flex items-center justify-center hover:bg-red-600 hover:text-white cursor-pointer transition-colors" title="Close">
                  <svg class="w-2.5 h-2.5" viewBox="0 0 10 10" stroke="currentColor"><line x1="0" y1="0" x2="10" y2="10" stroke-width="1.2"/><line x1="10" y1="0" x2="0" y2="10" stroke-width="1.2"/></svg>
                </span>
              </div>
            </div>
            <!-- Terminal Body -->
            <div class="p-3 font-mono text-[11px] leading-relaxed text-buddy-muted space-y-1">
              <div class="text-white/80">Windows PowerShell 7.4</div>
              <div class="text-emerald-400 pt-0.5">PS C:\RoboBuddy&gt; .\robo-buddy.exe --live</div>
              <div class="text-buddy-cyan">✓ Native station: Direct3D 11 active</div>
              <div class="text-buddy-purpleLight">✓ Audio loopback: WASAPI synchronized</div>
              <div class="text-emerald-400">✓ Collision furniture: 4 ledges mapped</div>
              <div class="text-white/60 text-[10px] pt-1 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-buddy-cyan animate-ping"></span>
                <span>Buddy roaming desktop perimeter...</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ==================== MOCK WINDOWS 11 TASKBAR (FLOOR) ==================== -->
    <div
      id="hero-taskbar"
      class="absolute bottom-0 inset-x-0 h-11 bg-[#121212]/95 border-t border-white/15 backdrop-blur-2xl z-20 flex items-center justify-between px-6 select-none pointer-events-auto shadow-2xl"
    >
      <!-- Center: Windows 11 Start & Running Robo Buddy App -->
      <div class="flex items-center gap-2 mx-auto">
        <!-- Windows 11 Start Icon (4 blue squares) -->
        <div class="w-7 h-7 rounded flex items-center justify-center hover:bg-white/10 cursor-pointer transition-colors" title="Start">
          <svg class="w-3.5 h-3.5 text-[#00adef]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M0 0h11v11H0zM13 0h11v11H13zM0 13h11v11H0zM13 13h11v11H13z"/>
          </svg>
        </div>
        <!-- Active Robo Buddy Task Tab -->
        <div class="relative flex items-center gap-1.5 px-3 py-1 rounded bg-white/10 border border-white/10 cursor-pointer" title="Robo Buddy (Active)">
          <img src="/images/logo-icon.png" alt="Robo Buddy" class="w-4 h-4 object-contain rounded" />
          <span class="text-xs text-white font-medium">Robo Buddy</span>
          <!-- Windows 11 Active App Underline Indicator -->
          <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-4 h-0.5 rounded-full bg-buddy-cyan"></span>
        </div>
      </div>

      <!-- Right: System Clock -->
      <div class="hidden sm:flex items-center gap-2 text-xs text-buddy-muted font-mono">
        <span class="text-[11px] text-white/90">11:42 PM</span>
      </div>
    </div>
  </section>

  <style>
    @keyframes window-shake {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      20% { transform: translate(-4px, 2px) rotate(-3deg); }
      40% { transform: translate(4px, -2px) rotate(3deg); }
      60% { transform: translate(-3px, 1px) rotate(-2deg); }
      80% { transform: translate(2px, -1px) rotate(1deg); }
    }
    .shake-impact {
      animation: window-shake 0.4s ease-in-out;
    }
  </style>

  <!-- ==================== FEATURE REEL (VIDEO DEMOS) ==================== -->
  <FeatureReel />

  <!-- ==================== CLIPPY MODE (NEW PROACTIVE AI) ==================== -->
  <ClippyShowcase />

  <!-- ==================== BENTO GRID CAPABILITIES ==================== -->
  <BentoGrid />

  <!-- ==================== DOWNLOAD CTA ==================== -->
  <DownloadCTA />

  <script>
    const tabComp = document.getElementById('tab-btn-companion');
    const tabTerm = document.getElementById('tab-btn-terminal');
    const compContent = document.getElementById('companion-tab-content');
    const termContent = document.getElementById('mobile-terminal-tab-content');

    tabComp?.addEventListener('click', () => {
      compContent?.classList.remove('hidden');
      termContent?.classList.add('hidden');
      tabComp.className = 'px-2 py-0.5 rounded bg-[#161616] text-white border-t border-buddy-cyan font-sans font-medium flex items-center gap-1';
      if (tabTerm) tabTerm.className = 'px-2 py-0.5 rounded text-buddy-muted hover:text-white flex items-center gap-1 font-sans';
    });

    tabTerm?.addEventListener('click', () => {
      compContent?.classList.add('hidden');
      termContent?.classList.remove('hidden');
      tabTerm.className = 'px-2 py-0.5 rounded bg-[#0c0c0c] text-white border-t border-buddy-cyan font-sans font-medium flex items-center gap-1';
      if (tabComp) tabComp.className = 'px-2 py-0.5 rounded text-buddy-muted hover:text-white flex items-center gap-1 font-sans';
    });
  </script>
</BaseLayout>
